# --- Text generation (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.9
OLLAMA_REQUEST_TIMEOUT_MS=30000

# --- Image generation (local, AUTOMATIC1111-compatible /sdapi/v1 API) ---
# Defaults below (768x768, 30 steps) assume a GPU-class machine (e.g. an
# RTX 4080 12GB + 64GB RAM) running stable-diffusion-webui with:
#   ./webui.sh --api
# (no --lowvram/--medvram needed at 12GB VRAM; GPU is used automatically —
# there's no separate "enable GPU" flag). On a weaker/CPU-only machine,
# drop IMAGE_GEN_WIDTH/HEIGHT to 512 and IMAGE_GEN_STEPS to ~20, and expect
# generation to take minutes instead of seconds.
IMAGE_GEN_ENABLED=true
IMAGE_GEN_HOST=http://127.0.0.1:7860
IMAGE_GEN_REQUEST_TIMEOUT_MS=20000
IMAGE_GEN_WIDTH=768
IMAGE_GEN_HEIGHT=768
IMAGE_GEN_STEPS=30
ILLUSTRATION_PROBABILITY=0.18
