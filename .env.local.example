# --- Text generation (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.9
OLLAMA_REQUEST_TIMEOUT_MS=30000

# --- Image generation (ai-image: idle-unloading ComfyUI supervisor, SDXL) ---
# The host runs POST /v1/images/generations synchronously, spawning ComfyUI
# on demand and killing it after idle to share VRAM with Whisper/Ollama.
# Cold start + first weight load can take minutes on a x1 PCIe link, hence
# the generous timeout. See http://<host>/docs for the full API.
IMAGE_GEN_ENABLED=true
IMAGE_GEN_HOST=http://constantinople:8189
IMAGE_GEN_REQUEST_TIMEOUT_MS=180000
IMAGE_GEN_MODEL=sdxl
IMAGE_GEN_WIDTH=1024
IMAGE_GEN_HEIGHT=1024
IMAGE_GEN_STEPS=25
IMAGE_GEN_CFG=7.0

# The first page always gets an illustration attempt (if image gen is
# enabled). After that, frequency adapts to how long generation actually
# takes: at/under ILLUSTRATION_FAST_MS it runs at ILLUSTRATION_MAX_PROBABILITY,
# at/over ILLUSTRATION_SLOW_MS (or on an outright timeout) it drops to 0.
ILLUSTRATION_MAX_PROBABILITY=0.25
ILLUSTRATION_FAST_MS=15000
ILLUSTRATION_SLOW_MS=90000

# --- Structured (skeleton) jump mode ---
STRUCTURED_WINDOW_SIZE=5
STRUCTURED_MEDIUM_HOPS=3

# --- Text-to-speech (ai-piper: English-only Piper TTS) ---
# POST /synthesize {"text": "..."} -> audio/wav. English voice only (en_US
# lessac), so the "Read Aloud" button is only offered while language=en.
TTS_ENABLED=true
TTS_HOST=http://constantinople:5002
TTS_REQUEST_TIMEOUT_MS=60000
